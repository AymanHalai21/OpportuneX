# ---- MySQL connection (local MySQL, Docker, or any hosted MySQL 8+)
DB_URL=jdbc:mysql://localhost:3306/opportunex?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# ---- JWT signing key: long random value (32+ characters)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# ---- true = app creates tables/procedures on start (and demo data once). false = run /database/*.sql yourself
DB_INIT=true

# ---- frontend origins allowed by CorsConfig (comma separated). Default: http://localhost:3000,http://localhost:5173
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
